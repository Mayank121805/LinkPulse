# LinkPulse Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=linkpulse_super_secret_production_key_2026_change_in_prod

# Database Configuration (MySQL recommended, SQLite fallback supported)
DATABASE_URL=mysql+pymysql://root:1234@127.0.0.1:3306/linkpulse_db

# Base URL for generated short links (e.g., http://localhost:5000 or https://linkpulse.io)
BASE_URL=http://localhost:5000

# Rate Limiting
RATELIMIT_DEFAULT=200/day;50/hour
RATELIMIT_STORAGE_URI=memory://

# Security & Session Settings
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
